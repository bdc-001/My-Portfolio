# Blog stats (votes + unique reads) are stored in Upstash Redis.
# On Vercel, add the Upstash Redis integration from the Marketplace and these are set for you.
# Locally, leave them unset to use a JSON file in .data/, or copy them into .env.local to hit real Redis.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: salt used when hashing visitor IPs for rate limiting.
BLOG_STATS_SALT=
